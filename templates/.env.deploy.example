# Copy to the app repo as .env.deploy and fill in (never commit .env.deploy).
# Prefer explicit FTPS (ftpes://) or SFTP (sftp://).
#   ftpes://  = explicit FTPS (port 21 + AUTH TLS) — rewritten to ftp:// + ssl-force for lftp
#   ftps://   = implicit FTPS (usually port 990)
#   sftp://   = SSH file transfer (not FTP)

FTP_HOST=ftpes://ftp.example.com
FTP_USER=your_username
FTP_PASS=your_password

# Parent remote directory only (apps land in <FTP_REMOTE_DIR>/<app-name>/).
# Example: /pub → deploys to /pub/stock-overlay
# Do NOT include the app name here unless you also set DEPLOY_APP_NAME differently.
FTP_REMOTE_DIR=/pub

# Optional: set to 1 to remove remote files that are not local (never touches excluded paths).
FTP_DELETE=0

# Optional overrides:
# DEPLOY_APP_NAME=my-app
# DEPLOY_DOCROOT=public
# DEPLOY_ENSURE_DIRS=data
# DEPLOY_EXCLUDE_GLOBS=tests/ docs/ '*.md'
